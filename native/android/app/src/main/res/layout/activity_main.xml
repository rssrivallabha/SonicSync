<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp"
    android:background="#090A0D">

    <TextView android:id="@+id/title" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="SonicSync Native" android:textColor="#FFFFFF" android:textSize="28sp" />
    <TextView android:id="@+id/state" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_marginTop="8dp" android:text="DISCONNECTED" android:textColor="#A7ADB7" android:textSize="16sp" />
    <EditText android:id="@+id/roomCode" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="24dp" android:hint="ROOM CODE" android:inputType="textCapCharacters"
        android:maxLength="6" android:textColor="#FFFFFF" android:textColorHint="#5E6570" />
    <Button android:id="@+id/join" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="12dp" android:text="JOIN NEARBY ROOM" />
    <Button android:id="@+id/testTone" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="12dp" android:text="AUDIO ENGINE TEST TONE" />
    <Button android:id="@+id/playMedia" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="12dp" android:text="PLAY STREAMING PCM MEDIA" />
    <TextView android:id="@+id/telemetry" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="24dp" android:textColor="#A7ADB7" android:textSize="14sp"
        android:text="Clock offset: —\nClock drift: —\nClock uncertainty: —\nPlayback phase error: —\nOutput latency: —" />
</LinearLayout>
