{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "outDir": "../../dist-web",
    "rootDir": "../.."
  },
  "include": ["../../core/sync/src/**/*.ts", "src/**/*.ts"],
  "exclude": ["../../node_modules", "../../dist"]
}
